{
  "info": {
    "name": "Devoluciones - devoluciones (v1)",
    "description": "Evidencias request/response del microservicio de devoluciones. Antes de correr: base_url y auth_url con la IP de la VM y password_demo en Current value. Cada corrida crea devoluciones reales; si la linea de venta se agota (409 sin_disponible), cambia venta_detalle_id por otra compra del mismo cliente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://IP-DE-LA-VM:8002"
    },
    {
      "key": "auth_url",
      "value": "http://IP-DE-LA-VM:8001"
    },
    {
      "key": "email_cliente",
      "value": "miguel.cliente@demo.mx"
    },
    {
      "key": "email_otro_cliente",
      "value": "ana.cliente@demo.mx"
    },
    {
      "key": "email_analista",
      "value": "josue.analista@demo.mx"
    },
    {
      "key": "password_demo",
      "value": ""
    },
    {
      "key": "venta_detalle_id",
      "value": "72"
    },
    {
      "key": "venta_detalle_ajena",
      "value": "85"
    },
    {
      "key": "motivo_id",
      "value": "1"
    },
    {
      "key": "token_cliente",
      "value": ""
    },
    {
      "key": "token_otro",
      "value": ""
    },
    {
      "key": "token_analista",
      "value": ""
    },
    {
      "key": "devolucion_id",
      "value": ""
    },
    {
      "key": "devolucion_xml_id",
      "value": ""
    },
    {
      "key": "folio",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Preparacion (tokens)",
      "item": [
        {
          "name": "health 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/health",
            "description": "RNF-22: el servicio y sus tres bases (PostgreSQL, Redis, MongoDB)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.test(\"mongodb ok\", () => pm.expect(pm.response.json().dependencias.mongodb.ok).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "login cliente (dueno de la compra)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{auth_url}}/api/v1/auth/login",
            "description": "Obtiene el JWT en el servicio auth (puerto 8001).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_cliente}}\",\n  \"password\": \"{{password_demo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.collectionVariables.set(\"token_cliente\", pm.response.json().access_token);"
                ]
