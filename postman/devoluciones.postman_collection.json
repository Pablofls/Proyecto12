    {
      "name": "01 Registro (POST)",
      "item": [
        {
          "name": "registrar 409 cantidad excedida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/devoluciones",
            "description": "Regla de negocio (RN-01): no se puede devolver mas de lo comprado. Va primero: si la linea ya no tuviera unidades, la respuesta seria sin_disponible.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"venta_detalle_id\": {{venta_detalle_id}},\n  \"motivo_id\": {{motivo_id}},\n  \"descripcion_problema\": \"El empaque llego roto y el producto derramado.\",\n  \"cantidad_devuelta\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error.tipo = cantidad_excedida\", () => pm.expect(pm.response.json().error.tipo).to.eql(\"cantidad_excedida\"));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "registrar 201 exitoso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/devoluciones",
            "description": "RF-07, RN-01: el cliente registra una devolucion sobre su compra. Crea la fila en PostgreSQL, la bitacora y un evento en MongoDB.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"venta_detalle_id\": {{venta_detalle_id}},\n  \"motivo_id\": {{motivo_id}},\n  \"descripcion_problema\": \"El empaque llego roto y el producto derramado.\",\n  \"cantidad_devuelta\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.collectionVariables.set(\"devolucion_id\", pm.response.json().id);",
                  "pm.collectionVariables.set(\"folio\", pm.response.json().folio_devolucion);",
                  "pm.test(\"estado solicitada\", () => pm.expect(pm.response.json().estado).to.eql(\"solicitada\"));",
                  "pm.test(\"Location al expediente\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/devoluciones/\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "registrar 201 XML",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/xml"
              },
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": "{{base_url}}/api/v1/devoluciones",
            "description": "Contrato XML: cuerpo validado contra devolucion_nueva.xsd y respuesta en XML.",
            "body": {
              "mode": "raw",
              "raw": "<devolucion>\n  <venta_detalle_id>{{venta_detalle_id}}</venta_detalle_id>\n  <motivo_id>{{motivo_id}}</motivo_id>\n  <descripcion_problema>Caja golpeada, el producto llego aplastado.</descripcion_problema>\n</devolucion>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.collectionVariables.set(\"devolucion_xml_id\", xml2Json(pm.response.text()).respuesta.id);"
                ]
              }
            }
          ]
        },
