      "name": "00 Salud y contratos",
      "item": [
        {
          "name": "contrato login.xsd 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/contratos/login.xsd",
            "description": "Seccion 6: el contrato XSD publicado por el servicio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es un XSD\", () => pm.expect(pm.response.text()).to.include(\"xs:schema\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "health 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/health",
            "description": "RNF-22: estado del servicio y de PostgreSQL/Redis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.test(\"estado ok\", () => pm.expect(pm.response.json().estado).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "health 200 XML",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": "{{base_url}}/health",
            "description": "Mismo recurso negociado en XML con Accept."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
