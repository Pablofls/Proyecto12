    {
      "name": "06 Casos limite (correr aparte)",
      "description": "Correr con el Collection Runner, cada request por separado y esperando 60 s entre ellos. El de bloqueo deja la cuenta {{email_bloqueo}} bloqueada 15 minutos.",
      "item": [
        {
          "name": "login 423 cuenta bloqueada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "RNF-12: tras 5 intentos fallidos la cuenta se bloquea 15 min (devoluciones:bloqueo:<email> en Redis y usuarios.bloqueado_hasta).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_bloqueo}}\",\n  \"password\": \"contrasena-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.collectionVariables.get(\"intentos_bloqueo\") || 0) + 1;",
                  "pm.collectionVariables.set(\"intentos_bloqueo\", n);",
                  "if (pm.response.code === 423 || n >= 7) {",
                  "  pm.test(\"HTTP 423 tras \" + n + \" intentos\", () => pm.response.to.have.status(423));",
                  "  pm.collectionVariables.set(\"intentos_bloqueo\", 0);",
                  "} else {",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "login 429 rate limit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "RNF-13: mas de 10 logins por minuto desde la misma IP (devoluciones:limite:<ip>:login con TTL 60 s). Revisar header Retry-After.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nadie@demo.mx\",\n  \"password\": \"x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.collectionVariables.get(\"intentos_limite\") || 0) + 1;",
                  "pm.collectionVariables.set(\"intentos_limite\", n);",
                  "if (pm.response.code === 429 || n >= 12) {",
                  "  pm.test(\"HTTP 429 tras \" + n + \" intentos\", () => pm.response.to.have.status(429));",
                  "  pm.collectionVariables.set(\"intentos_limite\", 0);",
                  "} else {",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
