    {
      "name": "01 Login",
      "item": [
        {
          "name": "login analista 200 exitoso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "RF-01, HU-01: emite access y refresh token y crea devoluciones:sesion_api:<sid> en Redis. Guarda los tokens en variables de la coleccion.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_analista}}\",\n  \"password\": \"{{password_demo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", r.access_token);",
                  "pm.collectionVariables.set(\"refresh_token\", r.refresh_token);",
                  "pm.collectionVariables.set(\"analista_id\", r.usuario.id);",
                  "pm.test(\"rol Analista\", () => pm.expect(r.usuario.rol).to.eql(\"Analista de Devoluciones\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "login admin 200 XML",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              },
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "Contrato XML: cuerpo y respuesta en XML. Guarda el token del Administrador.",
            "body": {
              "mode": "raw",
              "raw": "<login>\n  <email>{{email_admin}}</email>\n  <password>{{password_demo}}</password>\n</login>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "const r = xml2Json(pm.response.text()).respuesta;",
                  "pm.collectionVariables.set(\"admin_token\", r.access_token);",
                  "pm.test(\"rol Administrador\", () => pm.expect(r.usuario.rol).to.eql(\"Administrador\"));"
                ]
              }
            }
          ]
        },
