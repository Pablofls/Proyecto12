# Copiar a .env EN LA VM y completar. El archivo .env nunca se sube a git.

# --- Aplicacion ---
FLASK_SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
FLASK_ENV=development
APP_PORT=8000

# --- PostgreSQL (contenedor en la VM) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=devoluciones
POSTGRES_USER=devoluciones_app
POSTGRES_PASSWORD=cambiar-esta-password

# --- Redis (contenedor en la VM) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Politica de acceso (RNF-12) ---
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15

# --- Datos de demostracion ---
# Contrasena de las cuentas que crea scripts/seed_demo.py. Se deja vacia a
# proposito: el repositorio es publico y una contrasena escrita aqui seria una
# contrasena regalada. Si la dejas vacia, el script genera una al azar y la
# imprime una sola vez.
PASSWORD_DEMO=

# --- Google Cloud Storage (RF-09, RNF-15) ---
# Todavia no se usa en el primer parcial; las evidencias se registran sin subir archivo.
GCS_BUCKET=
