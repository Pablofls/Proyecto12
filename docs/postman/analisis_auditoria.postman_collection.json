              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 410\", () => pm.response.to.have.status(410));",
                  "pm.test(\"error.tipo = servicio_movido\", () => pm.expect(pm.response.json().error.tipo).to.eql(\"servicio_movido\"));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));"
                ]
