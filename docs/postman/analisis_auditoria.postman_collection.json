{
  "info": {
    "name": "Analisis y auditoria (analisis_auditoria) - v1",
    "description": "Evidencias request/response del servicio analisis_auditoria (puerto 8008). Requiere el environment vm.postman_environment.json con vm_host, password_demo y, si aplica, los ids de las colecciones previas. Orden de corrida y capturas: docs/evidencias/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Preparacion (tokens)",
      "item": [
        {
          "name": "health 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{analisis_url}}/health",
            "description": "RNF-22, RF-32: el servicio responde y reporta el estado de sus dependencias."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.test(\"postgresql ok\", () => { const J = pm.response.json(); pm.expect(J.dependencias.postgresql.ok === true).to.be.true; });",
                  "pm.test(\"redis ok\", () => { const J = pm.response.json(); pm.expect(J.dependencias.redis.ok === true).to.be.true; });",
                  "pm.test(\"mongodb ok\", () => { const J = pm.response.json(); pm.expect(J.dependencias.mongodb.ok === true).to.be.true; });"
                ]
              }
            }
          ]
        },
