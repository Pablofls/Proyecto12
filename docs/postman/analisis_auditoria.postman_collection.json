                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{analisis_url}}/api/v1/analisis/clasificar-motivo",
            "description": "La ruta ya no se ofrece aqui: responde 410 servicio_movido con el servicio sucesor.",
