    {
      "name": "06 Casos limite (correr aparte, bloquea una cuenta 15 min)",
      "item": [
        {
          "name": "login 423 cuenta bloqueada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{auth_url}}/api/v1/auth/login",
            "description": "RNF-12: tras 5 intentos fallidos la cuenta se bloquea 15 min; la peticion se repite sola hasta recibir 423. Usa email_bloqueo (Sofia) para no bloquear a los usuarios de las demas colecciones. Para desbloquear antes: `redis-cli DEL devoluciones:bloqueo:<correo> devoluciones:intentos:<correo>` y `UPDATE usuarios SET bloqueado_hasta = NULL WHERE email = '<correo>';`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_bloqueo}}\",\n  \"password\": \"contrasena-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.environment.get(\"intentos_bloqueo\") || 0) + 1;",
                  "pm.environment.set(\"intentos_bloqueo\", n);",
                  "if (pm.response.code === 423 || n >= 12) {",
                  "  pm.test(\"HTTP 423 tras \" + n + \" intentos\", () => pm.response.to.have.status(423));",
                  "  pm.environment.set(\"intentos_bloqueo\", 0);",
                  "} else {",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "login 429 rate limit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{auth_url}}/api/v1/auth/login",
            "description": "RNF-13: mas de 10 logins por minuto desde la misma IP; se repite sola hasta recibir 429 y se revisa Retry-After.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nadie@demo.mx\",\n  \"password\": \"x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.environment.get(\"intentos_limite\") || 0) + 1;",
                  "pm.environment.set(\"intentos_limite\", n);",
                  "if (pm.response.code === 429 || n >= 12) {",
                  "  pm.test(\"HTTP 429 tras \" + n + \" intentos\", () => pm.response.to.have.status(429));",
                  "  pm.environment.set(\"intentos_limite\", 0);",
                  "} else {",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
