{
  "info": {
    "name": "Autenticacion (auth) - v1",
    "description": "Evidencias request/response del servicio auth (puerto 8001). Requiere el environment vm.postman_environment.json con vm_host, password_demo y, si aplica, los ids de las colecciones previas. Orden de corrida y capturas: docs/evidencias/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Salud y contratos",
      "item": [
        {
          "name": "health 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{auth_url}}/health",
            "description": "RNF-22, RF-32: el servicio responde y reporta el estado de sus dependencias."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.test(\"postgresql ok\", () => { const J = pm.response.json(); pm.expect(J.dependencias.postgresql.ok === true).to.be.true; });",
                  "pm.test(\"redis ok\", () => { const J = pm.response.json(); pm.expect(J.dependencias.redis.ok === true).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "health 200 XML",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": "{{auth_url}}/health",
            "description": "Mismo health en XML (Accept: application/xml)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.test(\"estado ok\", () => { const X = xml2Json(pm.response.text()); pm.expect(X.respuesta.estado === \"ok\").to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "contrato login.xsd 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{auth_url}}/contratos/login.xsd",
            "description": "Los contratos XSD se publican en el propio servicio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.test(\"es un esquema XSD\", () => pm.expect(pm.response.text()).to.include(\"xs:schema\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Login",
      "item": [
        {
          "name": "login 200 exitoso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{auth_url}}/api/v1/auth/login",
            "description": "RF-01, HU-01: el analista inicia sesion y recibe access_token y refresh_token (JWT).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_analista}}\",\n  \"password\": \"{{password_demo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.test(\"emite el par de tokens\", () => { const J = pm.response.json(); pm.expect(J.token_type === \"Bearer\" && !!J.access_token && !!J.refresh_token && J.expires_in > 0).to.be.true; });",
                  "pm.test(\"el rol viaja en la respuesta\", () => { const J = pm.response.json(); pm.expect(J.usuario.rol === \"Analista de Devoluciones\").to.be.true; });",
                  "pm.environment.set(\"token_analista\", pm.response.json().access_token);",
                  "pm.environment.set(\"refresh_token\", pm.response.json().refresh_token);",
                  "pm.environment.set(\"analista_id\", pm.response.json().usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "login 200 XML (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              },
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": "{{auth_url}}/api/v1/auth/login",
            "description": "El mismo login con cuerpo y respuesta XML validados contra login.xsd.",
            "body": {
              "mode": "raw",
              "raw": "<login>\n  <email>{{email_admin}}</email>\n  <password>{{password_demo}}</password>\n</login>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));",
                  "pm.test(\"trae access_token\", () => { const X = xml2Json(pm.response.text()); pm.expect(!!X.respuesta.access_token).to.be.true; });",
                  "pm.environment.set(\"token_admin\", xml2Json(pm.response.text()).respuesta.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "login 400 datos invalidos",
