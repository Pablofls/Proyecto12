        {
          "name": "registrar 401 sin token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{inspecciones_url}}/api/v1/inspecciones",
            "description": "Endpoint protegido sin Authorization.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"devolucion_id\": {{devolucion_id}},\n  \"estado_empaque\": \"Empaque intacto, sello cerrado\",\n  \"danos\": false,\n  \"caducidad_vencida\": false,\n  \"cadena_frio_rota\": false,\n  \"minutos_fuera_refrigeracion\": 10,\n  \"temperatura_recepcion\": 4.5,\n  \"observaciones\": \"Inspeccion de prueba desde Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"error.tipo = no_autenticado\", () => pm.expect(pm.response.json().error.tipo).to.eql(\"no_autenticado\"));",
                  "pm.test(\"Trae X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));"
                ]
              }
