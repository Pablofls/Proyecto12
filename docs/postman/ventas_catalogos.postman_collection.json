                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{auth_url}}/api/v1/auth/login",
            "description": "Obtiene el JWT de Cliente (dueno de la compra) y lo guarda en token_cliente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_cliente}}\",\n  \"password\": \"{{password_demo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
