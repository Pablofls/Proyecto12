flowchart LR
    subgraph ACT["Usuarios (7 roles)"]
        direction TB
        CLI(["Cliente<br/><small>solicita y consulta su devolución</small>"]):::actor
        ANA(["Analista de Devoluciones<br/><small>autoriza, decide destino, analiza causas</small>"]):::actor
        COO(["Coordinador de Logística<br/><small>programa recolección, ruta y transportista</small>"]):::actor
        ENC(["Encargado del Centro<br/><small>confirma recepción</small>"]):::actor
        INS(["Inspector<br/><small>inspección física y cadena de frío</small>"]):::actor
        REE(["Encargado de Reembolsos<br/><small>aprueba o rechaza el reembolso</small>"]):::actor
        ADM(["Administrador<br/><small>usuarios, roles, catálogos, bitácora</small>"]):::actor
    end

    SYS["<b>Plataforma de Devoluciones y<br/>Logística Inversa con Análisis de Causa Raíz</b><br/><small>Proyecto 12 · Equipo 02<br/>Monolito web Flask · PostgreSQL · Redis</small>"]:::impl

    subgraph ORG["Organizaciones externas (registradas como catálogo)"]
        direction TB
        PROV["Proveedores<br/><small>origen de productos y lotes</small>"]:::ext
        TIE["Tiendas<br/><small>punto de venta original</small>"]:::ext
        TRA["Transportistas<br/><small>ejecutan la recolección</small>"]:::ext
    end

    subgraph INF["Infraestructura"]
        direction TB
        GCP["Google Cloud Platform<br/><small>Compute Engine (VM)</small>"]:::ext
        GCS["Google Cloud Storage<br/><small>fotos y documentos</small>"]:::futuro
    end

    CLI -->|"solicitud, evidencias, consulta de estado"| SYS
    ANA -->|"autorización, disposición, panel de causas"| SYS
    COO -->|"recolección y estados"| SYS
    ENC -->|"recepción en el centro"| SYS
    INS -->|"resultado de inspección"| SYS
    REE -->|"reembolso"| SYS
    ADM -->|"administración y auditoría"| SYS

    SYS -.->|"lotes y proveedor responsable"| PROV
    SYS -.->|"venta original por tienda"| TIE
    SYS -.->|"ruta y transportista asignado"| TRA
    SYS ==>|"se ejecuta en"| GCP
    SYS -.->|"archivos de evidencia (diseñado)"| GCS

    subgraph LEY["Leyenda"]
        direction LR
        L1["Implementado"]:::impl
        L2["Diseñado, no implementado"]:::futuro
    end
