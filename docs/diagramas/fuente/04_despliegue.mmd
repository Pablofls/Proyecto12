flowchart LR
    subgraph DEVS["Equipo de desarrollo (laptops)"]
        direction TB
        D1["Código Python / SQL<br/><small>no se levanta compose localmente</small>"]:::actor
    end
    GH["GitHub<br/><small>Pablofls/Proyecto12</small>"]:::ext
    USR(["Usuarios<br/>navegador"]):::actor

    subgraph GCP["Google Cloud Platform"]
        direction TB
        FW{{"Regla de firewall<br/>permitir-8000-devoluciones<br/><small>tcp:8000 · rangos de origen configurables</small>"}}:::ext
        subgraph VM["VM Compute Engine · CentOS (SELinux Enforcing)"]
            direction TB
            NAT[("PostgreSQL nativo de la VM<br/><small>:5432 · no usado por la app</small>")]:::futuro
            subgraph DK["Docker Engine · docker compose"]
                direction TB
                APP["devoluciones_app<br/><small>imagen python:3.11-slim<br/>gunicorn :8000</small>"]:::impl
                PG[("devoluciones_postgres<br/><small>postgres:16-alpine</small>")]:::db
                RD[("devoluciones_redis<br/><small>redis:7-alpine</small>")]:::db
                ENV[/".env (fuera de git)"/]:::nota
                SRC[/"bind mount ./ → /srv/app:z"/]:::nota
                VP[/"postgres_data"/]:::db
                VR[/"redis_data"/]:::db
            end
        end
    end

    D1 -->|"git push"| GH
    GH -->|"git pull en la VM"| SRC
    USR -->|"HTTP :8000"| FW --> APP
    SRC --- APP
    ENV --- APP
    APP --> PG
    APP --> RD
    PG --- VP
    RD --- VR
