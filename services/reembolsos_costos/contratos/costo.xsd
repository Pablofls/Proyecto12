<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="montoNoNegativo"><xs:restriction base="xs:decimal"><xs:minInclusive value="0"/><xs:fractionDigits value="2"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="etapaCosto"><xs:restriction base="xs:string">
    <xs:enumeration value="recoleccion"/><xs:enumeration value="transporte"/>
    <xs:enumeration value="inspeccion"/><xs:enumeration value="almacenamiento"/>
    <xs:enumeration value="reparacion"/><xs:enumeration value="reacondicionamiento"/>
    <xs:enumeration value="destruccion"/><xs:enumeration value="reembolso"/>
    <xs:enumeration value="otros"/>
  </xs:restriction></xs:simpleType>
  <xs:element name="costo"><xs:complexType><xs:sequence>
    <xs:element name="devolucion_id" type="xs:positiveInteger"/>
    <xs:element name="etapa" type="etapaCosto"/>
    <xs:element name="monto" type="montoNoNegativo"/>
  </xs:sequence></xs:complexType></xs:element>
</xs:schema>
