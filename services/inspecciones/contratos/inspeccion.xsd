<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="condicionTransporte"><xs:restriction base="xs:string">
    <xs:enumeration value="adecuada"/><xs:enumeration value="inadecuada"/><xs:enumeration value="desconocida"/>
  </xs:restriction></xs:simpleType>
  <xs:element name="inspeccion"><xs:complexType><xs:sequence>
    <xs:element name="devolucion_id" type="xs:positiveInteger"/>
    <xs:element name="estado_empaque" type="xs:string"/>
    <xs:element name="danos" type="xs:boolean"/>
    <xs:element name="empaque_alterado" type="xs:boolean" minOccurs="0"/>
    <xs:element name="faltantes" type="xs:boolean" minOccurs="0"/>
    <xs:element name="caducidad_vencida" type="xs:boolean"/>
    <xs:element name="cadena_frio_rota" type="xs:boolean" minOccurs="0"/>
    <xs:element name="minutos_fuera_refrigeracion" type="xs:nonNegativeInteger" minOccurs="0"/>
    <xs:element name="temperatura_recepcion" type="xs:decimal" minOccurs="0"/>
    <xs:element name="condicion_transporte" type="condicionTransporte" minOccurs="0"/>
    <xs:element name="evidencia_suficiente" type="xs:boolean" minOccurs="0"/>
    <xs:element name="observaciones" type="xs:string" minOccurs="0"/>
  </xs:sequence></xs:complexType></xs:element>
</xs:schema>
